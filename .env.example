# Postgres used by the admin platform
DATABASE_URL=

# Go API (qrave-backend) superadmin routes, used by Food Courts
SUPERADMIN_BACKEND_URL=http://127.0.0.1:9090
SUPERADMIN_API_KEY=
NEXT_PUBLIC_SUPERADMIN_API_URL=

# Required: signs admin sessions. 32+ random characters, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
SUPERADMIN_SESSION_SECRET=

# Optional env-only admin accounts (Super Admin): [{"username":"...","password":"..."}]
SUPERADMIN_USERS_JSON=
# Optional: key for POST /api/auth/users (first admin setup)
SUPERADMIN_BOOTSTRAP_KEY=

# Diner site that serves /fc/... (court QR codes and operator sign-in)
NEXT_PUBLIC_DINER_APP_URL=https://www.qravetech.in

SUPABASE_URL=
SUPABASE_ANON_KEY=
